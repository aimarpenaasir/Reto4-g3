# Copia este archivo como ~/.ssh/config y sustituye los valores entre <...>.
# Restringe los permisos del archivo local: chmod 600 ~/.ssh/config

Host manager-g3
    HostName <IP_PUBLICA_MANAGER>
    User ubuntu
    IdentityFile ~/.ssh/<CLAVE_PRIVADA_ALUMNO>
    IdentitiesOnly yes

Host worker1-g3
    HostName <IP_PRIVADA_WORKER1>
    User ubuntu
    IdentityFile ~/.ssh/<CLAVE_PRIVADA_ALUMNO>
    IdentitiesOnly yes
    ProxyJump manager-g3

Host worker2-g3
    HostName <IP_PRIVADA_WORKER2>
    User ubuntu
    IdentityFile ~/.ssh/<CLAVE_PRIVADA_ALUMNO>
    IdentitiesOnly yes
    ProxyJump manager-g3

Host worker3-g3
    HostName <IP_PRIVADA_WORKER3>
    User ubuntu
    IdentityFile ~/.ssh/<CLAVE_PRIVADA_ALUMNO>
    IdentitiesOnly yes
    ProxyJump manager-g3
